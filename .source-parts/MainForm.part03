        _eliteGrid.Columns.Add("Track", "TRACK");
        _eliteGrid.Columns.Add("Vehicle", "VEHICLE");
        _eliteGrid.Columns[0].Width = 150;
        _eliteGrid.Columns[1].Width = 165;
        _eliteGrid.Columns[2].Width = 110;
        _eliteGrid.Columns[3].Width = 125;
