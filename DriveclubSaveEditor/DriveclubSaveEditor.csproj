<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Driveclub PS4 Save Editor</AssemblyName>
    <RootNamespace>DriveclubSaveEditor</RootNamespace>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <Product>Driveclub PS4 Save Editor</Product>
    <Description>Offline Driveclub PS4 v1.28 save editor with deep-reviewed save integrity, refined dark UI, garage, customisation, progression and editable trophy preparation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\*.csv" />
    <EmbeddedResource Include="Data\*.txt" />
  </ItemGroup>
</Project>
